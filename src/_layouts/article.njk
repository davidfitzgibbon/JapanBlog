---
layout: page.njk
---

<link rel="stylesheet" href="/css/prism.css" />

<div class="article flow">
	<header>
	<h1>{{ title }}</h1>

		{% loc loc %}
		<img style="heading-img" src="{{img}}">
		{% biTime pubDate %}

	</header>

	{{ content | safe }}

</div>

<style>
	.article {
		margin: 0 auto 0;
		
		position: relative;
	}

	@media (min-width: 37.5em) {
		.article {
			margin: 0 auto 0;
		}
	}
</style>
