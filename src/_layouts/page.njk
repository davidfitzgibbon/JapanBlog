---
title: Japan Blog
description: Creative Development
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		<title>{{ title }}</title>

		<meta
			property="og:image"
			content="https://japan.davidfitz.dev/social/{{ title | slug }}.png"
		/>
		<meta
			name="twitter:image"
			content="https://japan.davidfitz.dev/social/{{ title | slug }}.png"
		/>

		<meta name="theme-color" content="#f00" />

		<meta name="description" content="{{ description }}" />
		<meta property="og:title" content="{% heading title %}" />
		<meta property="og:description" content="{{ description }}" />
		<meta property="og:image" content="/social.png" />
		<meta property="og:image:alt" content="{{ description }}" />
		<meta property="og:locale" content="en_IE" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta property="og:url" content={{
			"https://japan.davidfitz.dev" + page.url
		}}
		/> <link rel="canonical" href={{
			"https://japan.davidfitz.dev" + page.url
		}}
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Japan Blog"
		/>

		<link rel="webmention" href="https://webmention.io/lofi.codes/webmention" />

		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<!-- <Menu /> -->
		<div class="flow">
			{% include 'components/Logo.html' %}
			<div>
				{{ content | safe }}
			</div>
		</div>
		{% include 'components/Footer.njk' %}

	</body>
</html>
