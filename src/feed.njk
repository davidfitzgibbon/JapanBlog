<rss xmlns:content="http://purl.org/rss/1.0/modules/content/" version="2.0">
  <channel>
    <title>DavidFitz.dev</title>
    <description>Adventures with Creative Devlopment</description>
    <link>https://davidfitz.dev/</link>

    {%- for entry in collections.everythingByDate %}
    {# {%- for entry in collections.pensByDate %} #}
      <item>
        <title>{{entry.data.title}}</title>
        <link>{% sitedomain %}{{entry.url}}</link>
        <guid isPermaLink="true">{% sitedomain %}{{entry.url}}</guid>
        <pubDate>{{entry.data.pubDate}}</pubDate>
        <content:encoded>
          <![CDATA[
            {{entry.templateContent | safe}}
          ]]>
        </content:encoded>
        <language>en-ie</language>
      </item>
    {%- endfor %}
  </channel>
</rss>